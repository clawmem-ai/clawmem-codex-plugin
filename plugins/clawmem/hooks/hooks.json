{
  "description": "ClawMem lifecycle hooks for Codex: pre-prompt recall injection, post-turn conversation mirroring, and auto-memory sync. Plugin installs receive PLUGIN_ROOT from Codex; manual hook installs may still set CLAWMEM_CODEX_PLUGIN_ROOT.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAWMEM_PLUGIN_ROOT=\"${PLUGIN_ROOT:-$CLAWMEM_CODEX_PLUGIN_ROOT}\"; CLAWMEM_AGENT_PREFIX=codex CLAWMEM_STATE_DIR=\"${CLAWMEM_STATE_DIR:-$HOME/.local/state/clawmem}\" node \"$CLAWMEM_PLUGIN_ROOT/hooks/user-prompt-submit.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAWMEM_PLUGIN_ROOT=\"${PLUGIN_ROOT:-$CLAWMEM_CODEX_PLUGIN_ROOT}\"; CLAWMEM_AGENT_PREFIX=codex CLAWMEM_STATE_DIR=\"${CLAWMEM_STATE_DIR:-$HOME/.local/state/clawmem}\" node \"$CLAWMEM_PLUGIN_ROOT/hooks/stop.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "CLAWMEM_PLUGIN_ROOT=\"${PLUGIN_ROOT:-$CLAWMEM_CODEX_PLUGIN_ROOT}\"; CLAWMEM_AGENT_PREFIX=codex CLAWMEM_STATE_DIR=\"${CLAWMEM_STATE_DIR:-$HOME/.local/state/clawmem}\" node \"$CLAWMEM_PLUGIN_ROOT/hooks/post-tool-use.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
